{
  "name": "Route Art",
  "short_name": "Route Art",
  "description": "Turn a picture into a running route and a GPX file for your watch.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#eef1ee",
